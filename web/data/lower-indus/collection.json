 "id": "lower-indus",
 "title": "TerraPulse: Lower Indus, Sindh, Pakistan",
 "description": "Floods, wetlands and rice on the lower Indus. Surface change layers from 28 NISAR L2 GCOV passes (track 164, frame 76, descending), resampled to 100 m and published as 8-bit PNGs in Web Mercator. Open water uses HH and HV thresholds calibrated per radar mode on a permanent water body (keenjhar) against never-flooded land (jhimpir-desert). Passes are flagged when wind roughened the reference water or when at least 15.0 mm of GPM IMERG rain fell in the three days before.",
 "keywords": [
  "NISAR",
  "SAR",
  "L-band",
  "GCOV",
  "open water",
  "flooded vegetation",
  "change detection",
  "Pakistan"
 ],
